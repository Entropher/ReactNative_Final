# Copy this file to .env.local and fill in the values (see SETUP.md).
# All of these are public by design: they end up inside the app, and the
# database is protected by row level security, not by keeping them secret.
# Never put your Supabase secret key or your Anthropic API key here.

# Supabase dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Google Cloud console > Google Auth Platform > Clients (leave empty to hide Google sign-in)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
